    "music.metronome.bpmDetectorHint": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bata palmas, kick ou qualquer som rítmico estável. Detecto após 4-8 batidas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clap, kick or any steady rhythmic sound. Detection kicks in after 4-8 hits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplaude, marca un kick o cualquier sonido rítmico estable. Detecta tras 4-8 golpes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Applaudissez, frappez ou jouez tout son rythmique stable. Détection après 4-8 frappes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klatschen, Kick oder ein anderer gleichmäßiger rhythmischer Sound. Erkennung nach 4-8 Schlägen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手拍子、キック、または安定したリズム音を入力してください。4〜8回で検出します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请拍手、踩踏或制造稳定的节奏声。4-8 次后开始检测。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ताली बजाएं, किक करें या कोई भी स्थिर लयबद्ध ध्वनि करें। 4-8 बीट के बाद पता लगेगा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хлопайте, бейте или производите любой стабильный ритмичный звук. Определение после 4-8 ударов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفّق أو دق أو أحدث أي صوت إيقاعي ثابت. يتم الاكتشاف بعد 4-8 ضربات."
          }
        }
      }
    },
