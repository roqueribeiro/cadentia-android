    "music.piano.hint": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque com o mouse, toque ou teclado (A S D F G H J K = teclas brancas; W E T Y U = pretas)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play with mouse, touch or keyboard (A S D F G H J K = white keys; W E T Y U = black)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca con ratón, táctil o teclado (A S D F G H J K = teclas blancas; W E T Y U = negras)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez avec la souris, le toucher ou le clavier (A S D F G H J K = touches blanches ; W E T Y U = noires)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Maus, Touch oder Tastatur spielen (A S D F G H J K = weiße Tasten; W E T Y U = schwarze)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウス、タッチ、キーボードで演奏（A S D F G H J K = 白鍵; W E T Y U = 黒鍵）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用鼠标、触摸或键盘演奏 (A S D F G H J K = 白键; W E T Y U = 黑键)。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माउस, टच या कीबोर्ड से बजाएं (A S D F G H J K = श्वेत कुंजी; W E T Y U = काली)।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играйте мышью, касанием или клавиатурой (A S D F G H J K = белые клавиши; W E T Y U = чёрные)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العزف بالماوس أو اللمس أو لوحة المفاتيح (A S D F G H J K = المفاتيح البيضاء؛ W E T Y U = السوداء)."
          }
        }
      }
    },
