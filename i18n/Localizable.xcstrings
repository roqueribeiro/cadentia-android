    "cadentia.cordas.camera.strumHere": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe a mão direita pelas cordas"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweep your right hand across the strings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa la mano derecha por las cuerdas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez la main droite sur les cordes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streiche mit der rechten Hand über die Saiten"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右手で弦をなぞってください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用右手扫过琴弦"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दाएं हाथ को तारों पर फिराएं"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите правой рукой по струнам"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر يدك اليمنى على الأوتار"
          }
        }
      }
    },
    "cadentia.cordas.coach.camera.body": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre as duas mãos abertas para calibrar. Uma mão faz o acorde com os dedos, a outra atravessa as cordas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show both hands open to calibrate. One hand shapes the chord with its fingers, the other crosses the strings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las dos manos abiertas para calibrar. Una mano forma el acorde con los dedos, la otra cruza las cuerdas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montrez les deux mains ouvertes pour calibrer. Une main forme l'accord avec ses doigts, l'autre traverse les cordes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige beide Hände offen zum Kalibrieren. Eine Hand formt den Akkord mit den Fingern, die andere kreuzt die Saiten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両手を開いて見せるとキャリブレーションします。片方の手が指でコードを作り、もう片方が弦を横切ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "张开双手进行校准。一只手用手指组成和弦，另一只手横穿琴弦。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलिब्रेट करने के लिए दोनों हाथ खुले दिखाएँ। एक हाथ उँगलियों से कॉर्ड बनाता है, दूसरा तारों को पार करता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите обе раскрытые ладони для калибровки. Одна рука складывает аккорд пальцами, другая пересекает струны."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أظهر كلتا يديك مفتوحتين للمعايرة. يد تشكّل الكورد بأصابعها والأخرى تعبر الأوتار."
          }
        }
      }
    },
    "cadentia.cordas.coach.camera.title": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O violão entre as suas mãos"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guitar between your hands"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La guitarra entre tus manos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La guitare entre vos mains"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gitarre zwischen deinen Händen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両手のあいだにギター"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "吉他在你的双手之间"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गिटार आपके दोनों हाथों के बीच"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гитара между вашими руками"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجيتار بين يديك"
          }
        }
      }
    },
    "cadentia.cordas.coach.chords.body": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque um acorde para montá-lo nas cordas e rasgue logo abaixo. O capotraste está no painel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a chord to set it on the strings, then strum just below. The capo lives in the panel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un acorde para armarlo en las cuerdas y rasguea justo debajo. La cejilla está en el panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un accord pour le poser sur les cordes, puis grattez juste en dessous. Le capodastre est dans le panneau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe einen Akkord an, um ihn auf die Saiten zu legen, und schlage direkt darunter an. Der Kapodaster sitzt im Panel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードをタップすると弦に乗ります。そのすぐ下でストロークしてください。カポはパネルにあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一个和弦把它按在弦上，然后在下方扫弦。变调夹在面板里。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉर्ड पर टैप करके उसे तारों पर रखें और ठीक नीचे स्ट्रम करें। कैपो पैनल में है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите аккорд, чтобы поставить его на струны, и бейте прямо под ним. Каподастр — в панели."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس كورداً ليستقر على الأوتار ثم اضرب أسفله مباشرة. الكابو موجود في اللوحة."
          }
        }
      }
    },
    "cadentia.cordas.coach.chords.title": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha em cima, rasgue embaixo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick up top, strum below"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige arriba, rasguea abajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez en haut, grattez en bas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben wählen, unten anschlagen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上で選び、下でかき鳴らす"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上面选，下面扫"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर चुनें, नीचे स्ट्रम करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирайте сверху, бейте снизу"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر في الأعلى واضرب في الأسفل"
          }
        }
      }
    },
    "cadentia.cordas.coach.frets.body": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em cima você pisa as casas: um dedo por corda, dois ou mais arrastam o acorde inteiro pelo braço. Embaixo a unha rasga. A faixa do cavalete, no rodapé, abafa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the frets on the top half: one finger per string, two or more drag the whole chord along the neck. Down below, your nail strums. The bridge strip at the foot mutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba pisas los trastes: un dedo por cuerda, dos o más arrastran el acorde entero por el mástil. Abajo la uña rasguea. La franja del puente, al pie, apaga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En haut vous pressez les cases : un doigt par corde, deux ou plus déplacent tout l'accord le long du manche. En bas, l'ongle gratte. La bande du chevalet, tout en bas, étouffe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben greifst du die Bünde: ein Finger pro Saite, zwei oder mehr ziehen den ganzen Akkord über den Hals. Unten schlägt der Nagel an. Der Stegstreifen ganz unten dämpft."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上半分でフレットを押さえます。1本の指で1弦、2本以上ならコード全体がネックを移動します。下半分は爪でかき鳴らす場所。いちばん下のブリッジ帯はミュートです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上半部分按品：一根手指按一根弦，两根以上会把整个和弦沿琴颈拖动。下半部分用指甲扫弦。最下方的琴桥条是闷音区。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर के हिस्से में फ़्रेट दबाएँ: एक उँगली एक तार पर, दो या ज़्यादा पूरे कॉर्ड को गर्दन पर खिसकाती हैं। नीचे नाख़ून से स्ट्रम करें। सबसे नीचे की ब्रिज पट्टी आवाज़ दबाती है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверху вы зажимаете лады: один палец на струну, два и больше тянут весь аккорд по грифу. Снизу ноготь бьёт по струнам. Полоса бриджа внизу глушит."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في النصف العلوي تضغط على الدساتين: إصبع لكل وتر، واثنان أو أكثر يسحبان الكورد بأكمله على طول الزند. في الأسفل يضرب الظفر الأوتار. شريط الفرس في الأسفل يكتم الصوت."
          }
        }
      }
    },
