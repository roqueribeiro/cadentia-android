    "music.tuner.activateHint": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O afinador escuta seu instrumento ou voz e mostra a nota detectada em tempo real, com precisão de 1 cent."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tuner listens to your instrument or voice and shows the detected note in real time, accurate to 1 cent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El afinador escucha tu instrumento o voz y muestra la nota detectada en tiempo real, con precisión de 1 cent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accordeur écoute votre instrument ou votre voix et affiche la note détectée en temps réel, avec une précision de 1 cent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Stimmgerät hört Ihrem Instrument oder Ihrer Stimme zu und zeigt die erkannte Note in Echtzeit mit einer Genauigkeit von 1 Cent an."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チューナーは楽器や声を聞き取り、1セント精度で検出した音をリアルタイムに表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调音器会监听您的乐器或声音，并以 1 音分的精度实时显示检测到的音符。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्यूनर आपके वाद्य या आवाज़ को सुनता है और 1 सेंट की सटीकता के साथ रियल-टाइम में पकड़े गए नोट को दिखाता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тюнер слушает ваш инструмент или голос и отображает обнаруженную ноту в реальном времени с точностью 1 цент."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمع الموالف إلى آلتك أو صوتك ويعرض النغمة المكتشفة في الوقت الفعلي بدقة 1 سنت."
          }
        }
      }
    },
