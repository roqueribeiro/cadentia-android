    "cadentia.about.tagline": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um estúdio de bolso para quem estuda música."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pocket studio for people who study music."
          }
        },
