    "cadentia.sound.credits.intro": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gravações embarcadas são obra de outras pessoas, publicadas em domínio público (CC0). Nenhuma exige crédito — creditar é escolha nossa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bundled recordings are other people’s work, released into the public domain (CC0). None require credit — crediting is our choice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones incluidas son obra de otras personas, publicadas en dominio público (CC0). Ninguna exige crédito: acreditar es decisión nuestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements inclus sont l’œuvre d’autres personnes, publiés dans le domaine public (CC0). Aucun n’exige de crédit — créditer est notre choix."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die enthaltenen Aufnahmen stammen von anderen und stehen gemeinfrei (CC0). Keine verlangt eine Nennung — wir nennen sie trotzdem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収録音源は他の方々の作品で、パブリックドメイン（CC0）で公開されています。クレジットは不要ですが、あえて記載しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置录音是他人的作品，以公共领域（CC0）发布。均无需署名——署名是我们的选择。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शामिल रिकॉर्डिंग अन्य लोगों का काम है, सार्वजनिक डोमेन (CC0) में जारी। किसी को श्रेय की आवश्यकता नहीं — श्रेय देना हमारा चुनाव है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенные записи — работа других людей, выпущенная в общественное достояние (CC0). Указание авторства не требуется — мы указываем по своему выбору."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيلات المضمّنة من عمل أشخاص آخرين، منشورة في الملك العام (CC0). لا يشترط أي منها الإسناد — الإسناد اختيارنا."
          }
        }
      }
    },
