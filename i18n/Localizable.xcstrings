    "cadentia.tuner.analysis.hint": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque por até 60s e veja quanto tempo ficou afinado."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play for up to 60s and see how long you stayed in tune."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca hasta 60s y mira cuánto tiempo estuviste afinado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez jusqu'à 60s et voyez combien de temps vous êtes resté juste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele bis zu 60s und sieh, wie lange du sauber gestimmt warst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大60秒間演奏して、音程が合っていた時間を確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演奏最多 60 秒，查看你有多少时间保持音准。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "60 सेकंड तक बजाएं और देखें कि आप कितनी देर सुर में रहे।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играйте до 60 секунд и посмотрите, сколько времени вы держали строй."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعزف حتى 60 ثانية وشاهد كم من الوقت بقيت مضبوط الدوزان."
          }
        }
      }
    },
