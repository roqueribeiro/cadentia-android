    "cadentia.cordas.camera.pose.flat": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mãos estão quase lado a lado — deixe a do braço mais alta, na diagonal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your hands are almost side by side — raise the neck hand, on a diagonal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus manos están casi al mismo nivel — sube la del mástil, en diagonal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos mains sont presque côte à côte — remontez celle du manche, en diagonale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hände sind fast nebeneinander — die Griffhand höher, in die Diagonale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両手がほぼ横並びです。ネックの手を高く、斜めに構えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两只手几乎并排了——把按弦的手抬高，形成斜线。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके हाथ लगभग बराबर हैं — गर्दन वाला हाथ ऊपर उठाएँ, तिरछा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Руки почти на одной линии — поднимите руку на грифе, по диагонали."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يداك متجاورتان تقريباً — ارفع يد الزند لتصبحا على قطر مائل."
          }
        }
      }
    },
    "cadentia.cordas.camera.pose.upright": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mãos estão quase uma sobre a outra — afaste para os lados, na diagonal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your hands are almost stacked — open them out sideways, on a diagonal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus manos están casi una sobre otra — sepáralas hacia los lados, en diagonal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos mains sont presque l'une sur l'autre — écartez-les, en diagonale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hände stehen fast übereinander — weiter auseinander, in die Diagonale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両手がほぼ縦に重なっています。左右に開いて斜めに構えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两只手几乎上下重叠了——向两侧分开，形成斜线。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके हाथ लगभग एक के ऊपर एक हैं — बगल में फैलाएँ, तिरछा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Руки почти одна над другой — разведите их в стороны, по диагонали."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يداك فوق بعضهما تقريباً — باعد بينهما جانبياً على قطر مائل."
          }
        }
      }
    },
