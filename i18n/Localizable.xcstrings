    "cadentia.cordas.camera.denied.body": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo câmera precisa da câmera. Os modos Casas e Acordes continuam inteiros."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera mode needs the camera. Frets and Chords still work in full."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo cámara necesita la cámara. Trastes y Acordes siguen completos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode caméra a besoin de la caméra. Frettes et Accords restent complets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kameramodus braucht die Kamera. Bünde und Akkorde bleiben vollständig."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラモードにはカメラが必要です。フレットとコードはそのまま使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机模式需要相机。品位和和弦模式仍然完整可用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा मोड को कैमरा चाहिए। फ्रेट और कॉर्ड मोड पूरे काम करते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режиму камеры нужна камера. Лады и Аккорды работают полностью."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع الكاميرا يحتاج الكاميرا. وضعا الدساتين والأوتار يعملان بالكامل."
          }
        }
      }
    },
