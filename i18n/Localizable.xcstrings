          "stringUnit": {
            "state": "translated",
            "value": "بنصر"
          }
        }
      }
    },
    "cadentia.cordas.handChords.counting.footer": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta os dedos das duas mãos: a esquerda primeiro. O polegar não conta. Chacoalhe a mão direita para fazer a levada."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts the fingers on both hands, left first. The thumb does not count. Shake your right hand for the rhythm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta los dedos de ambas manos, la izquierda primero. El pulgar no cuenta. Agita la mano derecha para el ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte les doigts des deux mains, la gauche d'abord. Le pouce ne compte pas. Secouez la main droite pour le rythme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt die Finger beider Hände, links zuerst. Der Daumen zählt nicht. Schüttle die rechte Hand für den Rhythmus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両手の指を数えます（左が先）。親指は数えません。右手を振るとリズムが出ます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数两只手的手指，左手在前。拇指不计。摇动右手打节奏。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों हाथों की उंगलियां गिनता है, पहले बायां। अंगूठा नहीं गिनता। लय के लिए दायां हाथ हिलाएं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считает пальцы обеих рук, сначала левой. Большой не считается. Потрясите правой рукой для ритма."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعدّ أصابع اليدين، اليسرى أولاً. الإبهام لا يُحسب. هزّ يدك اليمنى لإخراج الإيقاع."
          }
        }
      }
    },
    "cadentia.cordas.handChords.footer": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pontos são os dedos levantados. A mão direita passa pelas cordas para tocar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dots are the raised fingers. The right hand sweeps the strings to play."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los puntos son los dedos levantados. La mano derecha recorre las cuerdas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les points sont les doigts levés. La main droite balaie les cordes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Punkte sind die gestreckten Finger. Die rechte Hand streicht über die Saiten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "点は立てた指です。右手で弦をなぞって鳴らします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆点表示伸出的手指。右手扫过琴弦发声。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिंदु उठी हुई उंगलियां हैं। दायां हाथ तारों पर फिराकर बजाता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точки — поднятые пальцы. Правая рука проводит по струнам."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النقاط هي الأصابع المرفوعة. اليد اليمنى تمر على الأوتار للعزف."
          }
        }
      }
    },
