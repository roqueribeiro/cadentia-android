      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "mão quase fora do quadro — afaste-se um pouco"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "hand almost out of frame — step back a little"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "la mano casi sale del cuadro — aléjate un poco"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "main presque hors cadre — reculez un peu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hand fast außerhalb des Bildes — etwas zurücktreten"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手が画面から出そうです — 少し離れて"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手快出画面了 — 请后退一点"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाथ फ्रेम से लगभग बाहर — थोड़ा पीछे हटें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "рука почти вне кадра — отойдите немного"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اليد تكاد تخرج من الإطار — ابتعد قليلاً"
          }
        }
      }
    },
