    "cadentia.setlists.noRecents": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra uma música primeiro. As músicas que você abrir aparecem aqui para entrar no repertório."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a song first. Songs you open show up here to join the setlist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una canción primero. Las canciones que abras aparecen aquí para entrar al repertorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez d'abord un morceau. Les morceaux ouverts apparaissent ici pour rejoindre le répertoire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne zuerst einen Song. Geöffnete Songs erscheinen hier für die Setliste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず曲を開いてください。開いた曲がここに表示され、セットリストに追加できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开一首歌。打开过的歌曲会出现在这里，可加入歌单。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले कोई गाना खोलें। खोले गए गाने यहाँ दिखेंगे और सेटलिस्ट में जुड़ सकेंगे।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала откройте песню. Открытые песни появятся здесь и попадут в сет-лист."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح أغنية أولاً. الأغاني التي تفتحها تظهر هنا لتنضم إلى القائمة."
