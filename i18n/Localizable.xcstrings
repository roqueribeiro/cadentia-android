    "cadentia.about.licensesIntro": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cadentia usa software livre de terceiros. Abaixo, o aviso de direitos autorais e a licença de cada um, como exigido por elas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadentia uses third-party open source software. Below are the copyright notice and license of each, as those licenses require."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadentia usa software libre de terceros. Abajo, el aviso de derechos de autor y la licencia de cada uno, como ellas exigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadentia utilise des logiciels libres tiers. Ci-dessous, l’avis de droits d’auteur et la licence de chacun, comme ces licences l’exigent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadentia nutzt quelloffene Software Dritter. Unten stehen Copyright-Hinweis und Lizenz jeder Komponente, wie es diese Lizenzen verlangen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadentiaは第三者のオープンソースソフトウェアを利用しています。以下は、それぞれの著作権表示とライセンスです。ライセンスがそれを求めています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadentia 使用了第三方开源软件。以下是各自的版权声明与许可证，这是这些许可证所要求的。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadentia तीसरे पक्ष के मुक्त स्रोत सॉफ़्टवेयर का उपयोग करता है। नीचे प्रत्येक का कॉपीराइट सूचना और लाइसेंस है, जैसा कि वे लाइसेंस अपेक्षित करते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadentia использует стороннее программное обеспечение с открытым исходным кодом. Ниже приведены уведомление об авторских правах и лицензия каждого, как того требуют эти лицензии."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Cadentia برمجيات مفتوحة المصدر من أطراف أخرى. في ما يلي إشعار حقوق النشر ورخصة كل منها، كما تشترط تلك الرخص."
          }
        }
      }
    },
