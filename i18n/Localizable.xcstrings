    "music.frequency.sweepHint": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Varre a frequência de A a B no tempo definido. Útil pra testar speakers, fones e fazer audiograma caseiro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweeps frequency from A to B over the chosen duration. Useful for testing speakers, headphones or DIY hearing tests."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Barre la frecuencia de A a B en el tiempo elegido. Útil para probar altavoces, auriculares o hacer audiometría casera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaye la fréquence de A à B sur la durée choisie. Utile pour tester haut-parleurs, casques ou faire un audiogramme maison."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweept die Frequenz von A nach B über die gewählte Dauer. Nützlich für Lautsprecher- oder Kopfhörertests sowie für DIY-Hörtests."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定した時間でAからBへ周波数をスイープします。スピーカーやヘッドフォンのテスト、自宅での聴覚テストに便利。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在指定时间内将频率从 A 扫到 B。适合测试扬声器、耳机或自制听力测试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयनित अवधि में A से B तक आवृत्ति को स्वीप करता है। स्पीकर, हेडफ़ोन या घरेलू श्रवण परीक्षण के लिए उपयोगी।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменяет частоту от A к B за заданное время. Полезно для тестирования динамиков, наушников или домашних слуховых тестов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمسح التردد من A إلى B خلال المدة المختارة. مفيد لاختبار السماعات أو سماعات الرأس أو اختبار السمع المنزلي."
          }
        }
      }
    },
