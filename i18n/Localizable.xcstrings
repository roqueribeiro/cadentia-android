    "cadentia.sound.emptyHint": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão foi montada sem os bancos. Tudo continua tocando com a síntese do app."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build shipped without the banks. Everything keeps playing with the app synthesis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión se creó sin los bancos. Todo sigue sonando con la síntesis de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version a été compilée sans les banques. Tout continue de jouer avec la synthèse de l'app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build kam ohne die Bänke. Alles spielt weiter mit der App-Synthese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドにはバンクが含まれていません。すべてアプリの合成音で鳴ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未包含音色库，所有声音继续使用应用合成音。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बिल्ड में बैंक शामिल नहीं हैं। सब कुछ ऐप सिंथेसिस से बजता रहेगा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
