          }
        }
      }
    },
    "cadentia.cordas.camera.calibrate.body": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque cada mão no seu círculo, como se estivesse segurando o violão, e segure parado um instante."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put each hand in its circle, as if you were holding the guitar, and hold still for a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon cada mano en su círculo, como si sostuvieras la guitarra, y quédate quieto un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez chaque main dans son cercle, comme si vous teniez la guitare, et restez immobile un instant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege jede Hand in ihren Kreis, als würdest du die Gitarre halten, und halte kurz still."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それぞれの手を円の中に置き、ギターを持つ姿勢のまま少し静止してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把每只手放进各自的圆圈里，像抱着吉他一样，保持不动片刻。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर हाथ को उसके घेरे में रखें, जैसे गिटार पकड़े हों, और एक पल स्थिर रहें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поместите каждую руку в свой круг, как будто держите гитару, и замрите на мгновение."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع كل يد في دائرتها كأنك تمسك الجيتار، وابقَ ثابتاً للحظة."
          }
        }
      }
    },
