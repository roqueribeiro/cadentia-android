    "cadentia.about.whatBody": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Afinador, metrônomo, bateria, piano, gravador multipista, tablatura e separação de instrumentos, num app só. Tudo gratuito e sem anúncio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuner, metronome, drums, piano, multitrack recorder, tablature and instrument separation, in one app. All free, with no ads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Afinador, metrónomo, batería, piano, grabador multipista, tablatura y separación de instrumentos, en una sola app. Todo gratis y sin anuncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordeur, métronome, batterie, piano, enregistreur multipiste, tablature et séparation d’instruments, dans une seule app. Le tout gratuit et sans publicité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimmgerät, Metronom, Schlagzeug, Klavier, Mehrspur-Recorder, Tabulatur und Instrumententrennung in einer App. Alles kostenlos und ohne Werbung."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チューナー、メトロノーム、ドラム、ピアノ、マルチトラック録音、タブ譜、楽器分離をひとつのアプリに。すべて無料、広告なし。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调音器、节拍器、鼓、钢琴、多轨录音、六线谱和乐器分离，集于一个应用。完全免费，没有广告。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्यूनर, मेट्रोनोम, ड्रम, पियानो, मल्टीट्रैक रिकॉर्डर, टैबलेचर और वाद्य पृथक्करण, एक ही ऐप में। सब मुफ़्त, बिना विज्ञापन।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тюнер, метроном, барабаны, пианино, многодорожечная запись, табулатура и разделение инструментов в одном приложении. Всё бесплатно и без рекламы."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مِعْيار دوزنة ومِيقاتية وطبول وبيانو ومسجّل متعدد المسارات وتدوين وفصل الآلات، في تطبيق واحد. كل ذلك مجاناً وبلا إعلانات."
          }
        }
      }
    },
