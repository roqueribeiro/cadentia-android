    "cadentia.cordas.panel.autoPluck.hint": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encostou na casa, a nota sai. Nas Casas e na Câmera."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch a fret and it sounds. In Frets and Camera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocas el traste y suena. En Trastes y Cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une case et la note sonne. Dans Cases et Caméra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bund antippen, Ton erklingt. In Bünde und Kamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレットに触れると鳴ります。フレットとカメラで有効。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触碰品位即出声。用于品位和摄像头模式。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ्रेट छूते ही आवाज़। फ्रेट्स और कैमरा में।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснулись лада — звучит. В режимах «Лады» и «Камера»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس الدرزة فتصدر النغمة. في وضعَي الدرزات والكاميرا."
          }
        }
      }
    },
