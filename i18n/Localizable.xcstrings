    "cadentia.stems.emptyBody": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma música e a Cadentia separa bateria, baixo, vocal e o resto. Tudo no aparelho, sem enviar nada para a internet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a song and Cadentia splits out drums, bass, vocals and the rest. All on your device, nothing leaves it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una canción y Cadentia separa batería, bajo, voz y lo demás. Todo en el dispositivo, nada sale de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un morceau et Cadentia sépare batterie, basse, voix et le reste. Tout sur l'appareil, rien n'en sort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Song und Cadentia trennt Schlagzeug, Bass, Gesang und den Rest. Alles auf dem Gerät, nichts verlässt es."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲を選ぶと、ドラム、ベース、ボーカル、その他に分けます。すべて端末内で処理し、外部には送りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一首歌，Cadentia 会分离出鼓、贝斯、人声和其余部分。全部在设备上完成，不上传任何内容。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक गाना चुनें और Cadentia ड्रम, बास, आवाज़ और बाकी हिस्सा अलग कर देगा। सब कुछ आपके डिवाइस पर, कुछ भी बाहर नहीं जाता।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите песню, и Cadentia отделит ударные, бас, вокал и остальное. Всё на устройстве, ничего не уходит наружу."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر أغنية وستفصل Cadentia الطبول والباس والغناء وبقية الآلات. كل ذلك على جهازك، ولا يخرج منه شيء."
          }
        }
      }
    },
