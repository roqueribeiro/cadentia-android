    "music.frequency.binauralHint": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouça com fones de ouvido. Frequências ligeiramente diferentes em cada ouvido criam uma \"batida\" perceptual pra relaxamento ou foco."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen with headphones. Slightly different frequencies in each ear create a perceptual \"beat\" for relaxation or focus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha con auriculares. Frecuencias ligeramente distintas en cada oído crean un \"pulso\" perceptual para relajación o concentración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoutez avec un casque. Des fréquences légèrement différentes dans chaque oreille créent un \"battement\" perceptuel pour la relaxation ou la concentration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hören Sie mit Kopfhörern. Leicht unterschiedliche Frequenzen in jedem Ohr erzeugen einen wahrnehmbaren \"Beat\" zur Entspannung oder Konzentration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッドフォンで聴いてください。左右で僅かに異なる周波数が知覚的な\"ビート\"を作り出し、リラクゼーションや集中に役立ちます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用耳机聆听。左右耳之间略有不同的频率会产生感知\"节拍\"，用于放松或集中注意力。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हेडफ़ोन के साथ सुनें। प्रत्येक कान में थोड़ी अलग आवृत्तियाँ विश्राम या एकाग्रता के लिए एक अनुभूत \"बीट\" बनाती हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушайте в наушниках. Немного разные частоты в каждом ухе создают воспринимаемый \"бит\" для релаксации или концентрации."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمع بسماعات الرأس. ترددات مختلفة قليلاً في كل أذن تخلق \"نبضة\" إدراكية للاسترخاء أو التركيز."
          }
        }
      }
    },
