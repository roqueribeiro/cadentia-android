    "cadentia.cordas.a11y.neck.hint": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Metade de cima pisa as casas, metade de baixo rasga as cordas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The top half presses the frets, the bottom half strums the strings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mitad de arriba pisa los trastes, la de abajo rasguea las cuerdas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La moitié du haut presse les cases, celle du bas gratte les cordes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die obere Hälfte greift die Bünde, die untere schlägt die Saiten an."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上半分でフレットを押さえ、下半分で弦をかき鳴らします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上半部分按品，下半部分扫弦。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर का आधा हिस्सा फ़्रेट दबाता है, नीचे का आधा तार स्ट्रम करता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Верхняя половина зажимает лады, нижняя бьёт по струнам."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النصف العلوي يضغط الدساتين والنصف السفلي يضرب الأوتار."
          }
        }
      }
    },
    "cadentia.cordas.a11y.strum": {
      "extractionState": "manual",
