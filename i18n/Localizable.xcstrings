    "cadentia.sound.hint": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha, por instrumento, entre a síntese do app e gravações reais. Dá para trocar enquanto toca."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose, per instrument, between the app synthesis and real recordings. You can switch while playing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige, por instrumento, entre la síntesis de la app y grabaciones reales. Puedes cambiar mientras tocas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez, par instrument, entre la synthèse de l'app et de vrais enregistrements. Vous pouvez changer en jouant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle pro Instrument zwischen der App-Synthese und echten Aufnahmen. Umschalten geht auch beim Spielen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "楽器ごとに、アプリの合成音と実録音を選べます。演奏中でも切り替えられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可为每种乐器在应用合成音与真实录音之间切换，演奏中也能切换。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर वाद्ययंत्र के लिए ऐप सिंथेसिस या असली रिकॉर्डिंग चुनें। बजाते हुए भी बदल सकते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите для каждого инструмента синтез приложения или живую запись. Переключать можно прямо во время игры."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر لكل آلة بين تركيب التطبيق والتسجيلات الحقيقية. يمكنك التبديل أثناء العزف."
          }
        }
      }
    },
