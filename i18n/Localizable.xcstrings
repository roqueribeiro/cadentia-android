    "cadentia.recorder.emptyHint": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão vermelho para gravar a primeira faixa. As próximas gravações tocam junto (overdub)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the red button to record your first track. New takes play along with the others (overdub)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón rojo para grabar la primera pista. Las siguientes tomas suenan junto a las demás (overdub)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton rouge pour enregistrer la première piste. Les prises suivantes jouent avec les autres (overdub)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den roten Knopf für die erste Spur. Weitere Aufnahmen laufen mit den anderen (Overdub)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤いボタンをタップして最初のトラックを録音。次のテイクは他のトラックと一緒に再生されます（オーバーダブ）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按红色按钮录制第一条音轨。后续录音将与其他音轨同时播放（叠录）。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहला ट्रैक रिकॉर्ड करने के लिए लाल बटन दबाएं। अगली रिकॉर्डिंग बाकी के साथ बजती हैं (ओवरडब)।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите красную кнопку, чтобы записать первую дорожку. Следующие дубли играют вместе с остальными (овердаб)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط الزر الأحمر لتسجيل المقطع الأول. التسجيلات التالية تُشغَّل مع البقية (أوفردَب)."
          }
        }
      }
    },
