    "music.tuner.deniedHint": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao microfone nas configurações pra usar o afinador."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone access in settings to use the tuner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso al micrófono en la configuración para usar el afinador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès au microphone dans les paramètres pour utiliser l'accordeur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie den Mikrofonzugriff in den Einstellungen, um das Stimmgerät zu verwenden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チューナーを使うには、設定でマイクのアクセスを許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中允许麦克风访问以使用调音器。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्यूनर का उपयोग करने के लिए सेटिंग्स में माइक्रोफ़ोन की अनुमति दें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к микрофону в настройках, чтобы использовать тюнер."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الميكروفون في الإعدادات لاستخدام الموالف."
          }
        }
      }
    },
