    "cadentia.library.pairingHint": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte a câmera de outro aparelho para o código, ou abra o endereço abaixo onde você já está logado. Confirme que os números batem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point another device's camera at the code, or open the address below where you are already signed in. Check the numbers match."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta la cámara de otro dispositivo al código, o abre la dirección de abajo donde ya iniciaste sesión. Comprueba que los números coincidan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointez la caméra d'un autre appareil vers le code, ou ouvrez l'adresse ci-dessous là où vous êtes déjà connecté. Vérifiez que les chiffres correspondent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte die Kamera eines anderen Geräts auf den Code oder öffne die Adresse unten dort, wo du bereits angemeldet bist. Prüfe, ob die Zahlen übereinstimmen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の端末のカメラでコードを読み取るか、すでにログイン済みの端末で下のアドレスを開いてください。数字が一致することを確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用另一台设备的相机扫描此码，或在你已登录的设备上打开下方地址，并核对数字是否一致。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे डिवाइस का कैमरा कोड पर रखें, या जहाँ आप पहले से साइन इन हैं वहाँ नीचे दिया पता खोलें। जाँचें कि अंक मेल खाते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите камеру другого устройства на код или откройте адрес ниже там, где вы уже вошли. Убедитесь, что цифры совпадают."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجّه كاميرا جهاز آخر نحو الرمز، أو افتح العنوان أدناه على جهاز سجّلت الدخول فيه. تحقق من تطابق الأرقام."
          }
        }
      }
    },
    "cadentia.library.pairingHintApp": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em aprovar: o RoqueOS abre já logado. Confirme que os números batem. Se preferir outro aparelho, aponte a câmera para o código."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap approve and RoqueOS opens already signed in. Check the numbers match. To use another device instead, point its camera at the code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca aprobar y RoqueOS se abre con la sesión iniciada. Comprueba que los números coincidan. Si prefieres otro dispositivo, apunta su cámara al código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez approuver et RoqueOS s'ouvre déjà connecté. Vérifiez que les numéros correspondent. Pour un autre appareil, pointez sa caméra vers le code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Bestätigen tippen, RoqueOS öffnet sich bereits angemeldet. Prüfe, ob die Zahlen übereinstimmen. Für ein anderes Gerät die Kamera auf den Code richten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認をタップすると RoqueOS がログイン済みで開きます。数字が一致することを確認してください。別の端末を使う場合はカメラをコードに向けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击批准，RoqueOS 将以已登录状态打开。请确认数字一致。若想用另一台设备，请用它的摄像头对准二维码。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वीकृत करें दबाएँ, RoqueOS पहले से साइन इन खुलेगा। जाँचें कि संख्याएँ मेल खाती हैं। दूसरा डिवाइस चाहें तो उसका कैमरा कोड पर रखें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите подтвердить, и RoqueOS откроется уже с входом в аккаунт. Проверьте совпадение цифр. Для другого устройства наведите его камеру на код."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الموافقة، وسيفتح RoqueOS وأنت مسجّل الدخول. تأكّد من تطابق الأرقام. لاستخدام جهاز آخر، وجّه كاميرته نحو الرمز."
          }
        }
      }
    },
