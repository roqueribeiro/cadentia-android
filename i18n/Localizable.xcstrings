    "cadentia.about.separationBody": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa uma música em voz, bateria, baixo e o restante, para você tirar um instrumento e tocar no lugar dele. O modelo roda na GPU do próprio iPhone, funciona sem internet e a música não sai do aparelho."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splits a song into vocals, drums, bass and everything else, so you can drop one instrument and play it yourself. The model runs on the iPhone's own GPU, works offline, and the music never leaves the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa una canción en voz, batería, bajo y el resto, para que quites un instrumento y lo toques tú. El modelo corre en la GPU del propio iPhone, funciona sin internet y la música no sale del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sépare un morceau en voix, batterie, basse et le reste, pour retirer un instrument et le jouer vous-même. Le modèle tourne sur le GPU de l’iPhone, fonctionne sans connexion, et la musique ne quitte jamais l’appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilt einen Song in Gesang, Schlagzeug, Bass und den Rest, damit du ein Instrument wegnehmen und selbst spielen kannst. Das Modell läuft auf der GPU des iPhones, funktioniert ohne Internet, und die Musik verlässt das Gerät nicht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲をボーカル、ドラム、ベース、その他に分けて、好きな楽器を抜いて自分で演奏できます。モデルはiPhoneのGPUで動き、オフラインでも使え、音楽が端末の外に出ることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把一首歌分成人声、鼓、贝斯和其余部分，你可以抽掉某个乐器自己来演奏。模型在 iPhone 自己的 GPU 上运行，离线可用，音乐不会离开这台设备。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी गाने को आवाज़, ड्रम, बेस और बाकी हिस्सों में बाँटता है, ताकि आप कोई एक वाद्य हटाकर खुद बजा सकें। मॉडल iPhone के अपने GPU पर चलता है, बिना इंटरनेट काम करता है, और संगीत डिवाइस से बाहर नहीं जाता।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделяет песню на вокал, барабаны, бас и остальное, чтобы вы убрали один инструмент и сыграли его сами. Модель работает на GPU самого iPhone, без интернета, и музыка не покидает устройство."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفصل الأغنية إلى غناء وطبول وباص وبقية الآلات، لتزيح آلة وتعزفها بنفسك. النموذج يعمل على معالج الرسوميات داخل الآيفون، ويشتغل بلا إنترنت، والموسيقى لا تغادر جهازك."
          }
        }
      }
    },
