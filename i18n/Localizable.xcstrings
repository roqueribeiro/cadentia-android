    "cadentia.stems.leaveFree": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode sair do app: a separação continua e avisa quando terminar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can leave the app — separation keeps going and tells you when it's done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes salir de la app: la separación continúa y te avisa al terminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez quitter l'app : la séparation continue et vous prévient à la fin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die App verlassen – die Trennung läuft weiter und meldet sich, wenn sie fertig ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを閉じても大丈夫です。分離は続き、完了したらお知らせします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以离开 App，分离会继续进行，完成后会通知你。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऐप से बाहर जा सकते हैं — अलगाव जारी रहेगा और पूरा होने पर बताएगा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно выйти из приложения — разделение продолжится и сообщит, когда закончит."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك مغادرة التطبيق — سيستمر الفصل وسنُعلمك عند الانتهاء."
          }
        }
      }
    },
