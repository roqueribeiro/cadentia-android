            "state": "translated",
            "value": "Toca una nota en el mástil o piano para escucharla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une note sur le manche ou le piano pour l'entendre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie eine Note auf dem Griffbrett oder Klavier an, um sie zu hören."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指板やピアノで音をタップして聴いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在指板或钢琴上轻触一个音符以听到它。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्रेटबोर्ड या पियानो पर एक नोट टैप करें उसे सुनने के लिए।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ноту на грифе или пианино, чтобы услышать её."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على نغمة في الزند أو البيانو لسماعها."
          }
        }
      }
    },
