# generated by storekit — edit store.config.json, not this file

# storekit drives the assets; fastlane drives the upload. Two jobs, two tools.

default_platform(:ios)

# Autenticação por chave de API. Sem isto o deliver cai no login por Apple ID,
# que pede 2FA e não roda sozinho — é o motivo de a chave existir.
def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
    duration: 1200,
    in_house: false
  )
end

platform :ios do
  desc "Regenerate metadata + screenshots, then push the listing to App Store Connect (no submit)"
  lane :listing do
    sh("cd .. && scripts/store.sh build")
    deliver(
      api_key: asc_key,
      skip_binary_upload: true,
      skip_app_version_update: false
    )
    UI.success("Listing is up. Review it in App Store Connect and press Submit yourself.")
  end

  desc "Build, sign and upload a build to TestFlight"
  lane :beta do
    sh("cd .. && scripts/release.sh")
  end

  desc "Listing + build in one go"
  lane :ship do
    beta
    listing
  end
end

platform :android do
  desc "Push the Play listing (metadata + graphics) without touching the release track"
  lane :listing do
    sh("cd .. && scripts/store.sh build")
    supply(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: false,
      validate_only: false
    )
  end

  desc "Upload the AAB to the internal track, listing included"
  lane :internal do
    supply(
      track: "internal",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      release_status: "draft"
    )
  end

  desc "Upload the AAB to the closed testing track (teste fechado)"
  lane :closed do
    supply(
      track: "alpha",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
