# Copie para keystore.properties (que está no .gitignore) e preencha.
#
# Gerar a chave — UMA VEZ, e guarde o arquivo e as senhas em lugar seguro:
# perder a chave de upload significa não conseguir mais atualizar o app na Play.
#
#   keytool -genkey -v -keystore ~/keys/cadentia-upload.jks \
#     -alias cadentia -keyalg RSA -keysize 2048 -validity 10000
#
# Caminho ABSOLUTO: o Gradle não expande `~`.
storeFile=/Users/voce/keys/cadentia-upload.jks
storePassword=
keyAlias=cadentia
keyPassword=
