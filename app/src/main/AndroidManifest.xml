<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Afinador e gravador escutam o instrumento. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Separar em segundo plano roda como serviço de primeiro plano. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 15+: "processar mídia" é exatamente o que a separação faz. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- A CPU acordada durante a leva; com teto, no serviço. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Cordas, modo câmera: o violão aparece entre as mãos. Pedida ao entrar
         no modo, nunca antes; sem câmera o braço e os acordes seguem valendo. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- Latência baixa: declara que o app quer o caminho de áudio pro. -->
    <uses-feature
        android:name="android.hardware.audio.low_latency"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.audio.pro"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Perguntar "o RoqueOS está instalado?" (canOpenURL do iOS) exige
         declarar o esquema aqui; sem isto a query volta vazia em silêncio. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="roqueos" />
        </intent>
    </queries>

    <application
        android:name=".CadentiaApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cadentia">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Cadentia">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Volta do pareamento do RoqueOS: cadentia://connected -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cadentia" />
            </intent-filter>
        </activity>

        <!-- O MediaPipe (Cordas, câmera) traz o datatransport da Google, que
             registra o backend "cct" por este meta-data e usaria ele para
             mandar estatística de uso ao Google. Sem o registro, o runtime
             descarta cada evento ("Transport backend 'cct' is not registered")
             e nada sai do aparelho. Não há opção pública no MediaPipe para
             desligar isso; esta é a única porta. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            android:exported="false">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>

        <!-- A leva de separação em segundo plano, com a notificação de progresso
             (o papel do BGContinuedProcessingTask e da Ilha Dinâmica no iOS). -->
        <service
            android:name=".features.stems.SeparationService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing|dataSync" />

        <!-- Compartilhar .rostab (o ShareSheet do iOS): expõe só o cache/share. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
