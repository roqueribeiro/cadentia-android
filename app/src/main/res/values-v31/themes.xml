<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: a splash do sistema também é palco grafite com o anel
         dourado, para a abertura animada do Compose emendar sem salto. -->
    <style name="Theme.Cadentia" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/stage_top</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowSplashScreenBackground">@color/stage_top</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
