    <string name="cadentia_about_licenses_intro">O Cadentia usa software livre de terceiros. Abaixo, o aviso de direitos autorais e a licença de cada um, como exigido por elas.</string>
    <string name="cadentia_about_link_community">Comunidade e suporte</string>
