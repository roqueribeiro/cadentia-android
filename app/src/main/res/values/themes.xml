<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Casca mínima: o visual de verdade é o tema Compose (ui/Theme.kt).
         A janela nasce no grafite do palco para não piscar claro no launch. -->
    <style name="Theme.Cadentia" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/stage_top</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
